# Environment
NODE_ENV="production"
APP_PORT="3141"
APP_MODULE="auth"

# App
APP_URL="http://localhost:3141"
APP_ORIGINS="http://localhost:3141"

# Database
DB_URL="mongodb+srv://<username>:<password>@<remaining URI>"
DB_NAME="vibe"
MONGOMS_DEBUG="true"

# Firebase Emulators
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
FIREBASE_EMULATOR_HOST="127.0.0.1:4000"
GCLOUD_PROJECT="example-project-id"

# ── Crowd-question screening filter (studentQuestions) ──
# Provider for the AI screening judge: 'groq' (free-tier demo) or 'anthropic' (prod).
SCREENING_PROVIDER=groq
SCREENING_ENABLED=true
# Context (lesson-relevance) checking — ON HOLD until real transcripts exist.
# When true, feeds lesson context to the on-topic gate + answer-correctness check.
SCREENING_CONTEXT_ENABLED=false
# Groq (free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Anthropic (prod) reuses ANTHROPIC_CRED / ANTHROPIC_MODEL above.
SCREENING_TIMEOUT_MS=9000
SCREENING_MAX_RETRIES=2
SCREENING_DEDUP_LIMIT=50
SCREENING_CONTEXT_CHARS=2000

# ── Uploaded video / HLS streaming (media module) ──
# Teachers upload straight to the upload bucket via a signed URL; a cloud
# transcoder writes an HLS ladder into the stream bucket. ViBe only signs URLs.
GOOGLE_VIDEO_UPLOAD_BUCKET=vibe-video-uploads
GOOGLE_VIDEO_STREAM_BUCKET=vibe-video-streams
# Lifetime of an issued upload URL (minutes). One hour covers a large file.
VIDEO_UPLOAD_URL_TTL_MINUTES=60
# Lifetime of a playback URL (minutes). HLS re-requests segments for the whole
# session, so this must outlast the longest expected watch or playback stalls
# mid-lesson. Moving to CDN signed cookies removes this constraint.
VIDEO_PLAYBACK_URL_TTL_MINUTES=360
# Largest upload we will issue a URL for (bytes). Default 5 GB.
VIDEO_MAX_UPLOAD_BYTES=5368709120
